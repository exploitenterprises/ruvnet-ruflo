node_modules/
data/cache/*.json
.env
.env.*
# CLI-generated per-run outputs (node cli.js update) are ephemeral, not committed.
# Dated report snapshots (e.g. futures-board-YYYY-MM-DD.md) from the recurring
# refresh ARE committed for history — only the CLI's own naming pattern is ignored.
reports/week-*.md
reports/week-*.json
# board/build.mjs output — derived from template.html + inlined fonts,
# regenerate with `node build.mjs`, never committed (same as red-hot-locks/site).
board/nfl-edge.html
